import numpy as np

# Função Stretched V Sine Wave
def stretched_v_sine_wave(x):
    total = 0
    for i in range(len(x) - 1):
        xi_sq = x[i]**2
        xj_sq = x[i + 1]**2
        r = (xi_sq + xj_sq)**0.25
        sin_term = np.sin(50 * (xi_sq + xj_sq)**0.1)**2
        total += r * (sin_term + 1)
    return total

# Valores de D
Ds = [2, 5, 10]

# Pontos de teste
test_vectors = {
    "[1,...,1]": lambda D: np.ones(D),
    "[0,...,0]": lambda D: np.zeros(D),
    "[-1,...,-1]": lambda D: -1 * np.ones(D),
    "[2,...,2]": lambda D: np.full(D, 2)
}

# Impressão dos resultados
print("\n==== Stretched V Sine Wave Function ====\n")
header = f"{'D':<4} | " + " | ".join(f"{label:>15}" for label in test_vectors.keys())
print(header)
print("-" * len(header))

for D in Ds:
    values = []
    for label, func in test_vectors.items():
        x = func(D)
        fx = stretched_v_sine_wave(x)
        values.append(f"{fx:15.6f}")
    print(f"{D:<4} | " + " | ".join(values))

print("\n# Schaffer Function N.3")
import numpy as np
from scipy.optimize import minimize
import time

# Função de Schaffer N.3
def schaffer3(x):
    x1, x2 = x
    num = np.sin(x1**2 - x2**2)**2 - 0.5
    den = (1 + 0.001 * (x1**2 + x2**2))**2
    return 0.5 + num / den

# Pontos iniciais para teste
initial_points = [
    [0, 0],
    [1, 1],
    [-2, 3],
    [3, -4],
    [5, 5],
    [-5, -5]
]

print("\n==== Schaffer Function N.3 Results ====\n")
header = f"{'x0':<15} | {'f(x*)':>12} | {'x*':>30} | {'Success'}"
print(header)
print("-" * len(header))

for x0 in initial_points:
    start = time.time()
    result = minimize(schaffer3, x0, method='BFGS')
    elapsed = (time.time() - start) * 1000
    print(f"{str(x0):<15} | {result.fun:12.6f} | {np.round(result.x, 6)} | {result.success}")

