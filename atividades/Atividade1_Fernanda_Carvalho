import numpy as np
from scipy.optimize import minimize
import time

# Função Hansen 1D
def hansen_1d(z):
    return sum(i * np.cos((i - 1) * z + i) for i in range(1, 6))

# Função Hansen 2D
def hansen(x):
    x1, x2 = x
    return hansen_1d(x1) * hansen_1d(x2)

# Pontos iniciais sugeridos
initial_points = [
    [0, 0],
    [2, 2],
    [-2, -2],
    [1.5, -1.5],
    [-1, 1]
]

print("\n==== Hansen Function Results ====\n")
header = f"{'x0':<20} | {'f(x*)':>12} | {'x*':>30} | {'Success'}"
print(header)
print("-" * len(header))

for x0 in initial_points:
    start = time.time()
    result = minimize(hansen, x0, method='BFGS')
    elapsed = (time.time() - start) * 1000
    print(f"{str(x0):<20} | {result.fun:12.6f} | {np.round(result.x, 6)} | {result.success}")

