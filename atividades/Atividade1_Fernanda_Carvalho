import numpy as np

# Função de Rosenbrock
def rosenbrock(x):
    return sum(100*(x[1:] - x[:-1]**2)**2 + (1 - x[:-1])**2)

# Valores de D
Ds = [2, 5, 10]

# Vetores de teste
test_vectors = {
    "[1,...,1]": lambda D: np.ones(D),
    "[0,...,0]": lambda D: np.zeros(D),
    "[1.2,...,1.2]": lambda D: np.full(D, 1.2),
    "[-1.2,...,-1.2]": lambda D: np.full(D, -1.2),
    "[2,...,2]": lambda D: np.full(D, 2)
}

# Impressão de resultados no estilo do notebook
print("\n==== Rosenbrock Evaluation ====\n")
header = f"{'D':<4} | " + " | ".join(f"{label:>15}" for label in test_vectors.keys())
print(header)
print("-" * len(header))

for D in Ds:
    values = []
    for label, func in test_vectors.items():
        x = func(D)
        fx = rosenbrock(x)
        values.append(f"{fx:15.6f}")
    print(f"{D:<4} | " + " | ".join(values))

